variable "name" { type = string }
variable "bucket_id" { type = string }
variable "bucket_arn" { type = string }
variable "source_dir" { type = string }

data "archive_file" "zip" {
  type        = "zip"
  source_file = "${var.source_dir}/handler.py"
  output_path = "${path.module}/build/file_processor.zip"
  # Lambda runs the code as a non-owner user: a 0600 handler.py would fail with "permission denied"
  output_file_mode = "0644"
}

resource "aws_cloudwatch_log_group" "lambda" {
  #checkov:skip=CKV_AWS_338:POC - 14-day retention keeps cost low; no compliance retention requirement
  #checkov:skip=CKV_AWS_158:POC - CloudWatch Logs are encrypted at rest by default; KMS CMK adds cost
  name              = "/aws/lambda/${var.name}-file-processor"
  retention_in_days = 14
}

data "aws_iam_policy_document" "assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "Service"
      identifiers = ["lambda.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "lambda" {
  name               = "${var.name}-lambda-role"
  assume_role_policy = data.aws_iam_policy_document.assume.json
}

data "aws_iam_policy_document" "perms" {
  statement {
    sid = "WriteOwnLogs"
    # ":*" = log streams inside this one log group (stream names are generated by Lambda at runtime)
    actions = ["logs:CreateLogStream", "logs:PutLogEvents"]
    #tfsec:ignore:aws-iam-no-policy-wildcards
    resources = ["${aws_cloudwatch_log_group.lambda.arn}:*"]
  }
  statement {
    sid       = "ReadUploadedObjects"
    actions   = ["s3:GetObject"]
    resources = ["${var.bucket_arn}/tickets/*"]
  }
}

resource "aws_iam_role_policy" "lambda" {
  name   = "${var.name}-lambda-policy"
  role   = aws_iam_role.lambda.id
  policy = data.aws_iam_policy_document.perms.json
}

resource "aws_lambda_function" "processor" {
  #checkov:skip=CKV_AWS_50:POC - X-Ray tracing not needed for a single log-only function
  #checkov:skip=CKV_AWS_117:Function only talks to S3/CloudWatch APIs; putting it in a VPC would need a NAT or endpoints (cost)
  #checkov:skip=CKV_AWS_116:S3 async invokes are retried twice by Lambda; failures surface via the lambda-errors alarm
  #checkov:skip=CKV_AWS_272:POC - code signing needs a Signer profile; code is deployed only by Terraform from this repo
  #checkov:skip=CKV_AWS_115:New accounts have a 10-concurrency limit, so reserving concurrency can fail; Errors alarm covers abuse
  function_name    = "${var.name}-file-processor"
  role             = aws_iam_role.lambda.arn
  runtime          = "python3.12"
  architectures    = ["arm64"]
  handler          = "handler.handler"
  filename         = data.archive_file.zip.output_path
  source_code_hash = data.archive_file.zip.output_base64sha256
  timeout          = 30
  memory_size      = 128

  depends_on = [aws_cloudwatch_log_group.lambda, aws_iam_role_policy.lambda]
}

resource "aws_lambda_permission" "s3" {
  statement_id  = "AllowS3Invoke"
  action        = "lambda:InvokeFunction"
  function_name = aws_lambda_function.processor.function_name
  principal     = "s3.amazonaws.com"
  source_arn    = var.bucket_arn
}

resource "aws_s3_bucket_notification" "attachments" {
  bucket = var.bucket_id
  lambda_function {
    lambda_function_arn = aws_lambda_function.processor.arn
    events              = ["s3:ObjectCreated:*"]
    filter_prefix       = "tickets/"
  }
  depends_on = [aws_lambda_permission.s3]
}

output "function_name" { value = aws_lambda_function.processor.function_name }
output "log_group_name" { value = aws_cloudwatch_log_group.lambda.name }
